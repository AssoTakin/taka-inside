{
  "kind": "singleType",
  "collectionName": "label_musical_pages",
  "info": {
    "singularName": "label-musical-page",
    "pluralName": "label-musical-pages",
    "displayName": "Page Label Musical",
    "description": "Contenu éditorial de la page globale /label-musical"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "seo": {
      "type": "component",
      "component": "shared.seo"
    },
    "hero": {
      "type": "component",
      "component": "label-musical.hero",
      "required": true
    },
    "stats": {
      "type": "component",
      "component": "label-musical.stat",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "artistsSectionTitle": {
      "type": "string",
      "required": true,
      "default": "Les talents Taka Inside"
    },
    "artistsSectionDescription": {
      "type": "richtext"
    },
    "artistsSectionCta": {
      "type": "component",
      "component": "shared.cta-button"
    },
    "artistsSectionCtaThreshold": {
      "type": "integer",
      "default": 4,
      "min": 1,
      "description": "Nombre d'artistes à partir duquel le bouton 'Voir tous les artistes' s'affiche"
    },
    "artistsPerRow": {
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 4,
      "description": "Nombre de cartes artistes par ligne sur desktop"
    },
    "actualitesSectionTitle": {
      "type": "string",
      "default": "Nos actualités"
    },
    "actualitesSectionDescription": {
      "type": "richtext"
    },
    "actualites": {
      "type": "component",
      "component": "musique.actualite",
      "repeatable": true
    },
    "callout": {
      "type": "component",
      "component": "label-musical.callout"
    },
    "artistFallbackLabel": {
      "type": "string",
      "default": "Artiste",
      "description": "Label affiché au-dessus du nom de chaque artiste quand le genre n'est pas renseigné"
    }
  }
}
