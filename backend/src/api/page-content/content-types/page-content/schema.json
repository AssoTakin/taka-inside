{
  "kind": "collectionType",
  "collectionName": "page_contents",
  "info": {
    "singularName": "page-content",
    "pluralName": "page-contents",
    "displayName": "Page Content",
    "description": "Contenu éditorial des pages statiques"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "content": {
      "type": "blocks",
      "required": true
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo"
    },
    "ctas": {
      "type": "component",
      "component": "shared.cta-button",
      "repeatable": true
    },
    "formConfig": {
      "type": "json",
      "description": "Configuration spécifique formulaire (champs, validation, etc.)"
    }
  }
}
