{
  "kind": "collectionType",
  "collectionName": "artistes",
  "info": {
    "singularName": "artiste",
    "pluralName": "artistes",
    "displayName": "Artiste"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nom"
    },
    "genre": {
      "type": "string"
    },
    "genre_musical": {
      "type": "string"
    },
    "biographie": {
      "type": "richtext"
    },
    "citation": {
      "type": "text"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "photo_cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "liens": {
      "type": "component",
      "component": "shared.liens-sociaux",
      "repeatable": false
    },
    "liens_streaming": {
      "type": "component",
      "component": "shared.streaming-link",
      "repeatable": true
    },
    "discographie": {
      "type": "component",
      "component": "musique.album",
      "repeatable": true
    },
    "actualites": {
      "type": "component",
      "component": "musique.actualite",
      "repeatable": true
    },
    "concerts": {
      "type": "component",
      "component": "evenement.concert",
      "repeatable": true
    },
    "produits_lies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::produit.produit",
      "inversedBy": "artistes"
    },
    "est_signe": {
      "type": "boolean",
      "default": true
    }
  }
}
