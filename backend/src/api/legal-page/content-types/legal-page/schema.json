{
  "kind": "collectionType",
  "collectionName": "legal_pages",
  "info": {
    "singularName": "legal-page",
    "pluralName": "legal-pages",
    "displayName": "Page Légale",
    "description": "Pages légales (CGV, mentions légales, confidentialité)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "lastUpdated": {
      "type": "date"
    },
    "content": {
      "type": "blocks",
      "required": true
    },
    "sections": {
      "type": "component",
      "component": "shared.legal-section",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo"
    }
  }
}
